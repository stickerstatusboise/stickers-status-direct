# Copy this file to .env.local and fill in the values. Never commit .env.local or paste these into chat.

# Supabase → Project Settings → Database → Connection string.
# Use the "Transaction pooler" string (port 6543) for the app, with your database password filled in.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Optional: your email, to get an admin account when loading the sample data
ADMIN_EMAIL=

# Sign-in (Supabase → Project Settings → API): Project URL and the anon / publishable key.
# These are public by design (they end up in the browser); the database password above is the secret one.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
