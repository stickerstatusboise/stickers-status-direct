# Copy this file to .env.local and fill in the values. Never commit .env.local or paste these into chat.

# Supabase → Project Settings → Database → Connection string.
# Use the "Transaction pooler" string (port 6543) for the app, with your database password filled in.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Optional: your email, to get an admin account when loading the sample data
ADMIN_EMAIL=

# Sign-in (Supabase → Project Settings → API): Project URL and the anon / publishable key.
# These are public by design (they end up in the browser); the database password above is the secret one.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# File storage (Supabase → Project Settings → API Keys): the service_role / secret key. SECRET: server only, never share.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: any long random string. Lets Vercel's daily job delete week-old uploads that never became orders.
CRON_SECRET=

# Payments (Stripe → Developers → API keys): the Secret key, sk_test_… while testing, sk_live_… at launch. SECRET.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint (…/api/stripe/webhook) → Signing secret, whsec_…. SECRET.
STRIPE_WEBHOOK_SECRET=
